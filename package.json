{
  "name": "pos-next",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:api": "pnpm --filter @pos/api start:dev",
    "dev:web": "pnpm --filter @pos/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:pull": "pnpm --filter @pos/api exec prisma db pull && node scripts/patch-schema.mjs",
    "db:generate": "pnpm --filter @pos/api exec prisma generate"
  }
}
