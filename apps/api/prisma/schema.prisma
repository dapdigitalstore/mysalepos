generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account_transactions {
  id                      Int                            @id @default(autoincrement()) @db.UnsignedInt
  account_id              Int
  type                    account_transactions_type
  sub_type                account_transactions_sub_type?
  amount                  Decimal                        @db.Decimal(22, 4)
  reff_no                 String?
  operation_date          DateTime                       @db.DateTime(0)
  created_by              Int
  transaction_id          Int?
  transaction_payment_id  Int?
  transfer_transaction_id Int?
  note                    String?                        @db.Text
  deleted_at              DateTime?                      @db.Timestamp(0)
  created_at              DateTime?                      @db.Timestamp(0)
  updated_at              DateTime?                      @db.Timestamp(0)

  @@index([account_id], map: "account_transactions_account_id_index")
  @@index([created_by], map: "account_transactions_created_by_index")
  @@index([operation_date], map: "account_transactions_operation_date_index")
  @@index([sub_type], map: "account_transactions_sub_type_index")
  @@index([transaction_id], map: "account_transactions_transaction_id_index")
  @@index([transaction_payment_id], map: "account_transactions_transaction_payment_id_index")
  @@index([transfer_transaction_id], map: "account_transactions_transfer_transaction_id_index")
  @@index([type], map: "account_transactions_type_index")
}

model account_types {
  id                     Int       @id @default(autoincrement()) @db.UnsignedInt
  name                   String
  parent_account_type_id Int?
  business_id            Int
  created_at             DateTime? @db.Timestamp(0)
  updated_at             DateTime? @db.Timestamp(0)

  @@index([business_id], map: "account_types_business_id_index")
  @@index([parent_account_type_id], map: "account_types_parent_account_type_id_index")
}

model accounts {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  business_id     Int
  name            String
  account_number  String
  account_details String?   @db.Text
  account_type_id Int?
  note            String?   @db.Text
  created_by      Int
  is_closed       Boolean   @default(false)
  deleted_at      DateTime? @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@index([account_type_id], map: "accounts_account_type_id_index")
  @@index([business_id], map: "accounts_business_id_index")
  @@index([created_by], map: "accounts_created_by_index")
}

model activity_log {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  log_name     String?
  description  String    @db.Text
  subject_id   Int?
  subject_type String?
  event        String?
  business_id  Int?
  causer_id    Int?
  causer_type  String?
  properties   String?   @db.Text
  batch_uuid   String?   @db.Char(36)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@index([log_name], map: "activity_log_log_name_index")
}

model barcodes {
  id                    Int       @id @default(autoincrement()) @db.UnsignedInt
  name                  String
  description           String?   @db.Text
  width                 Float?
  height                Float?
  paper_width           Float?
  paper_height          Float?
  top_margin            Float?
  left_margin           Float?
  row_distance          Float?
  col_distance          Float?
  stickers_in_one_row   Int?
  is_default            Boolean   @default(false)
  is_continuous         Boolean   @default(false)
  stickers_in_one_sheet Int?
  business_id           Int?      @db.UnsignedInt
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)
  business              business? @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "barcodes_business_id_foreign")

  @@index([business_id], map: "barcodes_business_id_foreign")
}

model bookings {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  contact_id       Int       @db.UnsignedInt
  waiter_id        Int?      @db.UnsignedInt
  table_id         Int?      @db.UnsignedInt
  correspondent_id Int?
  business_id      Int       @db.UnsignedInt
  location_id      Int       @db.UnsignedInt
  booking_start    DateTime  @db.DateTime(0)
  booking_end      DateTime  @db.DateTime(0)
  created_by       Int       @db.UnsignedInt
  booking_status   String
  booking_note     String?   @db.Text
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  business         business  @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bookings_business_id_foreign")
  contacts         contacts  @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bookings_contact_id_foreign")
  users            users     @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bookings_created_by_foreign")

  @@index([booking_status], map: "bookings_booking_status_index")
  @@index([business_id], map: "bookings_business_id_foreign")
  @@index([contact_id], map: "bookings_contact_id_foreign")
  @@index([correspondent_id], map: "bookings_correspondent_id_index")
  @@index([created_by], map: "bookings_created_by_foreign")
  @@index([location_id], map: "bookings_location_id_index")
  @@index([table_id], map: "bookings_table_id_index")
  @@index([waiter_id], map: "bookings_waiter_id_index")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model brands {
  id                   Int                    @id @default(autoincrement()) @db.UnsignedInt
  business_id          Int                    @db.UnsignedInt
  name                 String
  description          String?                @db.Text
  created_by           Int                    @db.UnsignedInt
  use_for_repair       Boolean                @default(true)
  deleted_at           DateTime?              @db.Timestamp(0)
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  business             business               @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "brands_business_id_foreign")
  users                users                  @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "brands_created_by_foreign")
  products             products[]
  repair_device_models repair_device_models[]
  repair_job_sheets    repair_job_sheets[]

  @@index([business_id], map: "brands_business_id_foreign")
  @@index([created_by], map: "brands_created_by_foreign")
}

